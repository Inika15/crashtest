# PayPal Credentials (get from developer.paypal.com → My Apps → Sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here

# AI Provider (get from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App Config
NODE_ENV=development
PORT=3001

# Demo Mode — set to "true" to run without any API keys (uses recorded fixtures)
MOCK_MODE=false

# Database (SQLite path for local dev; use a Neon/Supabase Postgres URL for Render)
DATABASE_URL=file:./dev.db

# Public URL of this API server (needed so targets can receive webhooks from the runner)
PUBLIC_API_URL=https://your-ngrok-or-render-url.app

# Target URLs (pre-filled for local dev; override in production)
NAIVE_TARGET_URL=http://localhost:3002
HARDENED_TARGET_URL=http://localhost:3003
